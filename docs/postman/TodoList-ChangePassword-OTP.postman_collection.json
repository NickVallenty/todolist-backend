        {
          "name": "2. Confirm & Change Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) {",
                  "  // Đổi thành công: cập nhật biến password để lần Login sau dùng mật khẩu mới",
                  "  pm.collectionVariables.set('password', pm.collectionVariables.get('newPassword'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
