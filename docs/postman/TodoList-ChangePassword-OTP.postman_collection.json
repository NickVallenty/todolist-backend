    {
      "name": "Account - Change Password (OTP)",
      "item": [
        {
          "name": "1. Request OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Có maskedEmail và expiresInSeconds', () => {",
                  "  pm.expect(body.maskedEmail).to.be.a('string');",
                  "  pm.expect(body.expiresInSeconds).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/account/change-password/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "change-password",
                "request-otp"
              ]
            },
            "description": "Yêu cầu Bearer Token (USER hoặc ADMIN). Không có body. Server tạo OTP 6 số và gửi tới email của chính tài khoản đang đăng nhập. OTP hết hạn sau 5 phút; giữa 2 lần xin OTP phải cách nhau tối thiểu 60 giây."
          },
