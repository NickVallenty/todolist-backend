@startuml change-password-otp-01-request-otp
title Đổi mật khẩu bằng OTP - Bước 1: Request OTP
autonumber

actor Client
participant "JwtAuthenticationFilter" as Filter
participant "ChangePasswordController" as Ctrl
participant "ChangePasswordOtpService" as Svc
participant "AppUserRepository" as UserRepo
participant "PasswordOtpRepository" as OtpRepo
participant "PasswordEncoder (BCrypt)" as Enc
participant "OtpMailService" as Mail
participant "SMTP Server" as SMTP
participant "ChangePasswordExceptionHandler" as Handler

Client -> Filter : POST /api/account/change-password/request-otp\nAuthorization: Bearer <token>

alt Token thiếu, không hợp lệ hoặc hết hạn
    Filter --> Client : 401 Unauthorized (ApiError từ SecurityConfig)
else Token hợp lệ
    Filter -> Ctrl : request kèm CustomUserDetails principal
    Ctrl -> Svc : requestOtp(userId lấy từ JWT)
    Svc -> UserRepo : findById(userId)
    UserRepo --> Svc : AppUser
    Svc -> OtpRepo : findFirstByUserIdOrderByOtpIdDesc(userId)\n(khóa ghi)
    OtpRepo --> Svc : OTP mới nhất hoặc rỗng

    alt Còn trong thời gian cooldown (mặc định 60 giây)
        Svc --> Handler : OtpException 429
        Handler --> Client : 429 Too Many Requests\nheader Retry-After
    else Được phép tạo OTP mới
        Svc -> OtpRepo : deleteByUserId(userId)\n(vô hiệu hóa OTP cũ)
        Svc -> Svc : sinh OTP 6 chữ số bằng SecureRandom
        Svc -> Enc : encode(otp)
        Enc --> Svc : otpHash
        Svc -> OtpRepo : save(userId, otpHash,\nexpiresAt = now + 5 phút, attempts = 0)
        Svc -> Mail : sendOtp(email, username, otp, 5)

        alt SMTP chưa cấu hình hoặc gửi mail lỗi
            Mail --> Svc : OtpException 503
            note over Svc, OtpRepo : Transaction rollback,\nkhông để lại OTP mồ côi
            Svc --> Handler : OtpException 503
            Handler --> Client : 503 Service Unavailable
        else Gửi mail thành công
            Mail -> SMTP : gửi email chứa OTP
            SMTP --> Mail : accepted
            Mail --> Svc : ok
            Svc --> Ctrl : OtpRequestedResponse (email đã che)
            Ctrl --> Client : 200 OK\nmessage, maskedEmail, expiresInSeconds
        end
    end
end

@enduml