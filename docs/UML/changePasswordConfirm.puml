@startuml change-password-otp-02-confirm
title Đổi mật khẩu bằng OTP - Bước 2: Confirm & Change Password
autonumber

actor Client
participant "JwtAuthenticationFilter" as Filter
participant "ChangePasswordController" as Ctrl
participant "ChangePasswordOtpService" as Svc
participant "AppUserRepository" as UserRepo
participant "PasswordOtpRepository" as OtpRepo
participant "PasswordEncoder (BCrypt)" as Enc
participant "ChangePasswordExceptionHandler" as Handler

Client -> Filter : POST /api/account/change-password/confirm\nAuthorization: Bearer <token>\nBody: otp, newPassword, confirmPassword

alt Token thiếu, không hợp lệ hoặc hết hạn
    Filter --> Client : 401 Unauthorized
else Token hợp lệ
    Filter -> Ctrl : request kèm CustomUserDetails principal
    Ctrl -> Ctrl : @Valid: otp đúng 6 số,\npassword 6-100 ký tự, confirm khớp

    alt Dữ liệu không hợp lệ
        Ctrl --> Client : 400 Bad Request\n(GlobalExceptionHandler trả ApiError kèm details)
    else Dữ liệu hợp lệ
        Ctrl -> Svc : confirm(userId lấy từ JWT, request)
        Svc -> UserRepo : findById(userId)
        UserRepo --> Svc : AppUser
        Svc -> OtpRepo : findFirstByUserIdOrderByOtpIdDesc(userId)\n(khóa ghi)
        OtpRepo --> Svc : PasswordOtp hoặc rỗng

        alt Chưa có OTP hoặc OTP đã hết hạn
            Svc --> Handler : OtpException 400
            Handler --> Client : 400 OTP không hợp lệ hoặc đã hết hạn
        else attempts đã đạt giới hạn (mặc định 5)
            Svc --> Handler : OtpException 400
            Handler --> Client : 400 Sai OTP quá số lần,\ncần yêu cầu OTP mới
        else OTP sai
            Svc -> Enc : matches(otp, otpHash)
            Enc --> Svc : false
            Svc -> OtpRepo : save(attempts + 1)
            note over Svc, OtpRepo : noRollbackFor OtpException\nnên bộ đếm vẫn được lưu
            Svc --> Handler : OtpException 400
            Handler --> Client : 400 OTP không đúng,\nkèm số lần còn lại
        else OTP đúng
            Svc -> Enc : matches(newPassword, password hiện tại)

            alt Password mới trùng password hiện tại
                Svc --> Handler : OtpException 400
                Handler --> Client : 400 Password mới phải khác password hiện tại\n(OTP vẫn còn hiệu lực)
            else Password mới khác password hiện tại
                Svc -> Enc : encode(newPassword)
                Enc --> Svc : newPasswordHash
                Svc -> UserRepo : save(user với password mới)
                Svc -> OtpRepo : delete(otp)\n(OTP chỉ dùng một lần)
                Svc --> Ctrl : hoàn tất
                Ctrl --> Client : 204 No Content
            end
        end
    end
end

@enduml